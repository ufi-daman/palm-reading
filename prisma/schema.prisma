generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Provozní statistiky. Bez osobních údajů, bez fotografií, bez IP adres.
/// Hlavní účel: měřit úspěšnost detekce čar v provozu (linesDetected vs.
/// linesManual), aby se prahy v lib/vision daly ladit na reálných datech.
model AnalysisStat {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  inputType       String   // "photo" | "interactive" | "text"
  handType        String

  linesDetected   Int      @default(0) // kolik čar našla detekce
  linesManual     Int      @default(0) // kolik jich uživatel doplnil nebo opravil

  usedAi          Boolean  @default(false)
  confidence      Float

  detectionDetail String?  // JSON: {lifeLine: {found: true, score: 0.8}, ...}

  @@index([createdAt])
  @@map("analysis_stats")
}

/// Jeden řádek = jedno volání AI rozboru (/api/vision), bez ohledu na to,
/// jestli z něj vzniklo dokončené čtení. Jediný účel: tvrdý denní strop
/// volání Anthropic API — v paměti by na serverless nefungoval spolehlivě.
model AiCallLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ai_call_log")
}
