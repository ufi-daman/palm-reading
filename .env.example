# Databáze (PostgreSQL) — statistiky, volitelné. Bez této proměnné aplikace
# běží normálně, jen se nezapisuje /admin/stats.
# Neon (https://neon.tech) nebo Vercel Postgres mají free tier.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Heslo pro /admin/stats (HTTP basic auth, uživatel "admin").
# Bez této proměnné je /admin nedostupné úplně.
ADMIN_PASSWORD=""

# AI rozbor fotografie (volitelné, viz app/api/vision). Bez klíče se
# tlačítko AI rozboru v UI skryje, zbytek aplikace funguje beze změny.
ANTHROPIC_API_KEY=""
