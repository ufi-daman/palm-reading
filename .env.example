# Databáze (PostgreSQL) — statistiky, volitelné. Bez této proměnné aplikace
# běží normálně, jen se nezapisuje /admin/stats.
# Neon (https://neon.tech) nebo Vercel Postgres mají free tier.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Heslo pro /admin/stats (HTTP basic auth, uživatel "admin").
# Bez této proměnné je /admin nedostupné úplně.
ADMIN_PASSWORD=""

# AI rozbor fotografie přes Gemini na Vertex AI (volitelné, viz
# app/api/vision). Bez kterékoli z těchto čtyř proměnných vrací endpoint 503
# a tlačítko v UI zůstane nepoužitelné, zbytek aplikace funguje beze změny.
# Vyžaduje i DATABASE_URL — bez něj nejde vynutit denní strop volání, takže
# AI rozbor zůstává vypnutý schválně.
#
# GOOGLE_SERVICE_ACCOUNT_JSON — celý obsah staženého klíče servisního účtu
# (JSON), vložený jako text jedné proměnné. Servisní účet potřebuje jen roli
# "Vertex AI User" (roles/aiplatform.user), nic víc.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# ID projektu v Google Cloud (pole "project_id" v souboru výše).
GOOGLE_CLOUD_PROJECT=""
# Region Vertex AI, např. "us-central1".
GOOGLE_CLOUD_LOCATION=""
# Přesné ID modelu z Vertex AI Model Garden, např. "gemini-2.5-pro" —
# hodnotu nevymýšlejte, zkopírujte ji ze stránky modelu v Model Garden.
VISION_MODEL=""

# Kolik AI rozborů denně nejvýš povolit (bezpečnostní strop proti utracení
# API kreditu). Výchozí hodnota beze změny: 20.
VISION_DAILY_CAP="20"
